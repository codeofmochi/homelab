# This file is managed by Ansible
network:
  version: 2
  renderer: networkd
{% if network_interfaces | length == 0 %}
  ethernets: {}
{% else %}
  ethernets:
{% for interface in network_interfaces %}
    {{ interface.name }}:
      addresses:
{% for address in interface.addresses %}
        - {{ address }}
{% endfor %}
{% if interface.gateway4 is defined and interface.gateway4 | default('') != '' %}
      gateway4: {{ interface.gateway4 }}
{% endif %}
{% if interface.gateway6 is defined and interface.gateway6 | default('') != '' %}
      gateway6: {{ interface.gateway6 }}
{% endif %}
{% if interface.nameservers is defined %}
      nameservers:
        addresses:
{% for ns in interface.nameservers %}
          - {{ ns }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
