# Network Interfaces
secrets_public_eth_name: "eth1"
secrets_private_eth_name: "eth2"
secrets_default_eth_name: "eth3"

# Subnet Prefix: Required for Netplan to form a valid CIDR address (e.g. 192.168.1.10/24).
# For standard subnets:
# - Class C /24 (255.255.255.0 netmask): prefix is 24 (e.g., 192.168.1.x subnet)
# - Class B /16 (255.255.0.0 netmask): prefix is 16
secrets_public_interface_prefix: "24"
secrets_private_interface_prefix: "24"
secrets_default_interface_prefix: "24"

secrets_public_interface_ip: "192.168.55.10"
secrets_private_interface_ip: "192.168.56.11"
secrets_private_interface_ipv6: "fd00:abcd:1::11"
secrets_default_interface_ip: "192.168.57.12"
secrets_default_interface_ipv6: "fd00:abcd:2::12"

# Pi-hole Configuration
secrets_pihole_admin_password: "your_pihole_admin_password_here"
secrets_pihole_dhcp_start: "192.168.56.100"
secrets_pihole_dhcp_end: "192.168.56.200"
secrets_pihole_local_ipv6: "fd00:abcd:1::11"
secrets_lan_router_ip: "192.168.56.1"

# WireGuard Configuration
secrets_wireguard_port: 51820
secrets_wireguard_server_url: "vpn.yourdomain.com"
# Allowed IPs configuration:
# - Split-tunneling (local routes only, peer gets ad blocking via Pi-hole): "192.168.56.0/24,10.13.13.0/24"
# - Full-tunneling (routes all peer traffic through the VPN): "0.0.0.0/0, ::/0"
secrets_wireguard_allowed_ips: "192.168.56.0/24,10.13.13.0/24"

# Vaultwarden Configuration
secrets_vaultwarden_admin_password: "your_vaultwarden_admin_password_here"
